# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Primary Database
MONGODB_URI=mongodb://localhost:27017/ai-recruitment

# Authentication
JWT_SECRET=replace-with-a-secure-32-byte-hex-secret

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=recruitment_vectors

# AI Semantic Embeddings (BAAI/bge-small-en-v1.5)
HUGGINGFACE_API_KEY=

# LLM Providers (Groq & OpenRouter)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Transactional Email (Resend)
RESEND_API_KEY=

# Production Integrity Guards (Set to true to disable degraded in-memory fallbacks)
REQUIRE_PERSISTENT_STORAGE=false
REQUIRE_SEMANTIC_EMBEDDINGS=false
